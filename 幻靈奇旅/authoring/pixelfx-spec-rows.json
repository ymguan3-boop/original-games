[{"section":"A","item":"野外草地／林地環境","trigger":"野外探索、樹叢飄葉、自然氛圍","ids":["weather/falling-leaves","nature/leaf-storm","critters/butterfly"],"rule":"常駐採低密度；葉暴屬技能，不能把所有飄葉都當傷害。"},{"section":"A","item":"水域／河畔／魚群","trigger":"水域移動、釣魚、河流場景","ids":["water/ripples","water/splash","critters/fish-school","water/bubbles"],"rule":"保留 Three.js 河道、釣魚碰撞、水域限制；特效只當疊加層。"},{"section":"A","item":"晴朗與日光","trigger":"晴天場景的局部陽光、飄雲","ids":["weather/clouds","weather/god-rays"],"rule":"不覆寫場景背景、全局光照與導航可視性。"},{"section":"A","item":"霧氣／夜景","trigger":"夜間、林地、幽暗區域","ids":["weather/fog","weather/fireflies","critters/wisp"],"rule":"低頻循環；避免透明材質遮蔽目標與捕捉提示。"},{"section":"A","item":"雨天／雪天","trigger":"季節及特殊天候（若場景配置已有）","ids":["weather/rain","weather/snow","water/rain-splash"],"rule":"依現有配置啟用；不得憑空全場改天氣。"},{"section":"A","item":"角色跑動／衝刺","trigger":"動作殘影、移動速度提示","ids":["moves/dash-strike","status/haste","spawn/poof"],"rule":"moves 為含假人演出，實際只抽取光效／殘影，不取代角色骨架。"},{"section":"A","item":"主角普通攻擊與命中","trigger":"基礎擊打、受擊回饋","ids":["impacts/hit-spark","impacts/blunt-hit","impacts/hit-flash"],"rule":"傷害仍由現有戰鬥規則計算；不因亮光重複扣血。"},{"section":"A","item":"捕捉球擲出／命中","trigger":"靈核球拋出、觸發捕捉回饋","ids":["projectiles/energy-disc","pickups/collect-burst","impacts/hit-spark"],"rule":"不得改變投球軌跡、捕捉機率、球模型及物件拾取規則。"},{"section":"A","item":"首次捕捉／圖鑑卡","trigger":"收服成功、收藏卡出現","ids":["spawn/summon-rise","ui/achievement","pickups/collect-burst"],"rule":"沿用首捕卡片與重複捕捉的素材袋動畫。"},{"section":"A","item":"道具自動吸附／撿拾","trigger":"背包被動吸收、星露果、靈核球","ids":["pickups/loot-beam","pickups/gem-spin","ui/coin-collect"],"rule":"僅在實際拾取成功時播放；保留數量上限與每十秒吸收規則。"},{"section":"A","item":"治療／狀態增減","trigger":"藥水、回血、增益、負面狀態","ids":["holy/heal","holy/heal-aoe","status/poisoned","status/frozen"],"rule":"特效跟隨角色；狀態持續時間與規則不改。"},{"section":"A","item":"場景 NPC 與互動提示","trigger":"新任務、感嘆號、完成任務","ids":["ui/exclamation","ui/quest-complete","ui/achievement"],"rule":"UI 文字、位置及點擊優先權保留。"},{"section":"A","item":"傳送／進出建物","trigger":"研究所、入口、開啟副本","ids":["arcane/portal","scifi/warp-in","scifi/warp-out"],"rule":"僅在場景切換成功時使用；不影響載入與安全區域。"},{"section":"A","item":"野外敵人生成／消散","trigger":"幻靈出現、怪物離開、野外遭遇","ids":["spawn/poof","spawn/spawn-portal","spawn/dissolve-burn"],"rule":"原本 spawn 率、冷卻、圖鑑百分比門檻不改。"},{"section":"A","item":"三色蛋／防護／回滿","trigger":"金色護盾、回復光柱、減攻","ids":["scifi/force-field","holy/divine-shield","holy/holy-pillar"],"rule":"保留原技能範圍、效果與三色蛋識別。"},{"section":"A","item":"過場與提示動畫","trigger":"勝利、失敗、關卡切換","ids":["transitions/star-iris","ui/confetti","ui/achievement"],"rule":"轉場不擋操作、不造成白黑全畫面閃屏；避免強制播放進化動畫。"},{"section":"B","item":"全角色普攻命中","trigger":"目前 combatFx／combatRing／arenaFeedback","ids":["impacts/hit-spark","impacts/blunt-hit","ui/damage-number"],"rule":"完整保留 HP、能量、屬性剋制及回合制動作順序。"},{"section":"B","item":"全角色絕招蓄力","trigger":"大招前置動作、腳下法陣","ids":["arcane/spell-charge","arcane/rune-circle","lightning/charge-up"],"rule":"請依屬性及技能屬性挑選，非一律用閃電。"},{"section":"B","item":"大眼蛙 Bump／Bubbles","trigger":"leaf-frog://articuno 原生撞擊與泡泡","ids":["impacts/blunt-hit","water/bubbles","water/splash"],"rule":"保留原生 Bump、Bubbles 姿勢與原生控制器。"},{"section":"B","item":"冒險蛙 Kick／Boomerang","trigger":"moltres：側踢及單目標回旋鏢","ids":["melee/uppercut","nature/leaf-storm","impacts/ricochet","impacts/hit-spark"],"rule":"特殊規格見第九章；鏢本體以原模型，不拿 fx 假物件代替。"},{"section":"B","item":"水毛蟲水彈／三連吐絲","trigger":"entei：水彈、三次絲線與成網","ids":["water/water-orb","projectiles/magic-missile","nature/root-snare"],"rule":"保留 0.62／1.0／1.7／2.4 秒的原生時間點；應按速度比例重計。"},{"section":"B","item":"小金魚普通／絕招","trigger":"kyogre：翻身吐細水柱、漣漪","ids":["water/water-jet","water/ripples","water/splash"],"rule":"不可用通用光球替代小金魚原生動畫。"},{"section":"B","item":"金魚王／金魚后","trigger":"groudon、rayquaza 水彈及光波","ids":["water/water-orb","water/wave-crash","water/splash"],"rule":"保留兩者各自動作和鏡頭構圖。"},{"section":"B","item":"水蛟龍王","trigger":"mewtwo：龍咬／水柱","ids":["melee/claw-swipe","water/geyser","water/water-jet"],"rule":"沿用原生 1.9／5.8s 演出語意，可按事件裁切效果時間。"},{"section":"B","item":"剝皮辣椒雞家族","trigger":"啄擊、單支／多支辣椒投擲","ids":["melee/thrust","fire/fireball","projectiles/arrow","impacts/hit-spark"],"rule":"保留 3／6／12＋1 辣椒數量與逐支順序。"},{"section":"B","item":"汪汪犬家族","trigger":"咬擊、水彈、激流、海嘯、水刃","ids":["melee/claw-swipe","water/water-orb","water/wave-crash","water/water-jet"],"rule":"保留階段成長後技能差異。"},{"section":"B","item":"水仙子／水系魔法","trigger":"水泡、水柱、落雨、水花","ids":["water/bubbles","water/geyser","water/rain-splash"],"rule":"落雨屬技能時只顯示作用區，不改擂台天氣。"},{"section":"B","item":"火熊／貓女家族","trigger":"爪擊、噴火、火柱、震地、斬擊","ids":["melee/claw-swipe","fire/fire-breath","fire/flame-pillar","nature/quake"],"rule":"近戰先接近再攻擊，特效對齊武器／爪位置。"},{"section":"B","item":"龐克兔吉他二連擊","trigger":"raichu Ultimate，模型內建兩擊","ids":["melee/double-slash","lightning/zap-hit","impacts/hit-spark"],"rule":"第 2.18／2.90 原生命中點縮放同步；不能破壞跳到敵方正前方的動作。"},{"section":"B","item":"阿宏牛仔","trigger":"雙槍射擊、槍口火花","ids":["projectiles/muzzle-pistol","projectiles/bullet-tracer","impacts/bullet-impact"],"rule":"使用既有 GLB 原生動作，不遮蓋雙槍。"},{"section":"B","item":"藍金星輝法師","trigger":"星環、能量與魔法投射物","ids":["arcane/arcane-missiles","arcane/mana-burst","arcane/star-fall"],"rule":"保留施法姿勢與模型命中事件。"},{"section":"B","item":"官胖／鐮刀角色","trigger":"近戰刀光、魔法符印、收割","ids":["melee/scythe-reap","shadow/soul-drain","impacts/crit-hit"],"rule":"保留原 GLB 武器軌跡，pixelfx 只加強視覺。"},{"section":"B","item":"其他未設計專屬動畫的幻靈","trigger":"撞擊＋同色小光球／大光球","ids":["impacts/blunt-hit","arcane/arcane-orb","arcane/mana-burst"],"rule":"依角色色系重新著色，普攻約 0.55s／絕招約 1.15s。"},{"section":"B","item":"元素：焰、潮、森","trigger":"火球、水柱、藤蔓與樹葉","ids":["fire/fireball","water/water-jet","nature/vine-whip"],"rule":"先依 skill.name／屬性／是否射擊選效果，再配置位置。"},{"section":"B","item":"元素：雷、念、光","trigger":"落雷、念波、聖光、護盾","ids":["lightning/zap-hit","arcane/arcane-beam","holy/smite","holy/divine-shield"],"rule":"雷電局部命中，禁止變動全局場景明暗。"},{"section":"B","item":"增益／異常狀態","trigger":"燒傷、冰凍、中毒、暈眩、攻擊提升","ids":["status/burning","status/frozen","status/poisoned","status/stunned","status/rage"],"rule":"狀態特效隨附狀態消失，回合計數以既有系統為準。"},{"section":"B","item":"勝負／角色退場","trigger":"受擊、倒下、角色更換","ids":["spawn/shatter-death","spawn/dissolve-burn","ui/achievement"],"rule":"不可用預設假人演出替代模型倒地／受擊。"},{"section":"B","item":"河畔釣魚／書櫃擂台","trigger":"共享擂台邏輯的變體","ids":["water/ripples","arcane/magic-circle-cast","impacts/hit-spark"],"rule":"共用同一特效映射與 3v3 規則，避免漏修。"},{"section":"C","item":"主角刀劍普攻","trigger":"近戰斬擊、刀光、金屬火花","ids":["melee/sword-slash","melee/double-slash","impacts/hit-spark"],"rule":"依刀、劍等武器判斷命中距離，不改實際攻擊判定。"},{"section":"C","item":"雙刀／快速攻擊","trigger":"快速多段斬擊","ids":["melee/dagger-flurry","melee/spin-slash"],"rule":"多次圖像不代表額外傷害；依既有連擊事件觸發。"},{"section":"C","item":"槍械普攻","trigger":"槍口火花、彈道、落點","ids":["projectiles/muzzle-smg","projectiles/bullet-tracer","impacts/bullet-impact"],"rule":"維持現有射程、穿透及追蹤判定。"},{"section":"C","item":"鐮刀／特殊武器","trigger":"收割軌跡、靈魂、爆擊","ids":["melee/scythe-reap","shadow/soul-drain","impacts/crit-hit"],"rule":"尊重角色原生動畫與武器幾何。"},{"section":"C","item":"普攻衝刺與翻滾","trigger":"主角位移、殘影","ids":["moves/dash-strike","spawn/poof","status/haste"],"rule":"保留翻滾無敵幀、距離與方向。"},{"section":"C","item":"英雄大絕：劍、雙刀","trigger":"範圍斬擊與波紋","ids":["melee/heavy-cleave","melee/spin-slash","impacts/ground-slam"],"rule":"依武器原有終結技特性選效果。"},{"section":"C","item":"英雄大絕：槍、能量","trigger":"連射、貫穿、能量圈","ids":["moves/pistol-shots","scifi/emp-blast","projectiles/plasma-shot"],"rule":"動作與子彈數不改，單純套用命中光效。"},{"section":"C","item":"幻靈普攻／大絕","trigger":"沿用模型室原生招式與元素特效","ids":["arcane/magic-circle-cast","impacts/hit-spark","fire/fireball"],"rule":"不回退到泛用球；原生 skill release 定義優先。"},{"section":"C","item":"冒險蛙飛鏢","trigger":"洞穴中連鎖多敵人技能","ids":["nature/leaf-storm","impacts/ricochet","impacts/hit-spark"],"rule":"與擂台共用同一 1 秒飛鏢路徑控制器與事件。"},{"section":"C","item":"水蛟龍王及水系","trigger":"水彈、水柱、浪潮","ids":["water/water-orb","water/geyser","water/wave-crash"],"rule":"已存在原生招式，效果只換皮。"},{"section":"C","item":"怪物生成／死亡","trigger":"敵人進場、倒地、消散","ids":["spawn/summon-rise","spawn/poof","spawn/shatter-death"],"rule":"由 state.events 統一接入，避免漏掉魔物死亡。"},{"section":"C","item":"陷阱、地面異常","trigger":"冰凍、毒霧、雷電、泥地","ids":["ice/ice-spikes","nature/poison-cloud","lightning/zap-hit","nature/toxic-puddle"],"rule":"陷阱碰撞與持續秒數仍由原規則控制。"},{"section":"C","item":"持續傷害／減益","trigger":"燃燒、毒、中斷、暈眩","ids":["status/burning","status/poisoned","status/stunned"],"rule":"特效每個怪最多一個同類實例，消失時釋放資源。"},{"section":"C","item":"補血與防護","trigger":"治療、護盾、復活","ids":["holy/heal","holy/divine-shield","holy/resurrection"],"rule":"技能不存在時不額外製造復活機制。"},{"section":"C","item":"道具獲取／寶箱","trigger":"金幣、技能書、抽卡、戰利品","ids":["pickups/loot-beam","pickups/chest-open","pickups/gem-spin","ui/level-up"],"rule":"物資、幣值、抽卡稀有機率不改。"},{"section":"C","item":"關卡波次／魔王","trigger":"波次提示、Boss 登場、大招","ids":["ui/countdown","arcane/portal","explosions/plasma-explosion"],"rule":"魔王召喚／難度和勝敗判定不改。"},{"section":"C","item":"洞穴氛圍","trigger":"火把、水霧、漂浮粒子","ids":["fire/torch","weather/fog","critters/bat","critters/wisp"],"rule":"低成本，避免常駐高量影片紋理。"},{"section":"C","item":"結算／單局升級與退化","trigger":"勝負、當局進階、退回基礎幻靈","ids":["ui/achievement","ui/level-up","transitions/pixel-dissolve"],"rule":"維持單局結束復歸基礎形態；不重新開啟已要求關閉的進化演出。"},{"section":"D","item":"基礎幻靈普攻","trigger":"近戰、射擊、追蹤、範圍","ids":["melee/sword-slash","projectiles/magic-missile","impacts/hit-spark"],"rule":"依 rules.js 實際事件，不改攻速／血量／AI。"},{"section":"D","item":"六屬性大絕","trigger":"焰、潮、森、雷、念、光","ids":["fire/flame-pillar","water/geyser","nature/leaf-storm","lightning/zap-hit","arcane/mana-burst","holy/smite"],"rule":"依 element 使用對應 VFX，禁止環境變色或全畫面白閃。"},{"section":"D","item":"各級 Boss 進場／受擊","trigger":"巢穴 Boss 站立、出場、咆哮","ids":["spawn/summon-rise","impacts/ground-slam","ui/exclamation"],"rule":"保留 Boss 出場條件、血條與原生動作。"},{"section":"D","item":"巢穴、木桶基地受擊","trigger":"砲擊、命中閃光、衝擊波","ids":["impacts/blunt-hit","impacts/shield-block","ui/health-bar-hit"],"rule":"只亮木桶或巢穴局部；**保留既有 PK 木桶血量減半設定**。"},{"section":"D","item":"陷阱：泥坑／荊棘","trigger":"泥地減速、棘刺、土石","ids":["nature/toxic-puddle","nature/thorns","nature/earth-spike"],"rule":"維持路上可自設陷阱，不新增原本沒有的固定障礙。"},{"section":"D","item":"陷阱：旋風／噴泉","trigger":"旋風、地泉、浮空","ids":["nature/tornado","water/geyser","water/splash"],"rule":"命中由既有陷阱邏輯決定。"},{"section":"D","item":"陷阱：符文／電擊","trigger":"法陣、陷阱感電","ids":["arcane/rune-circle","lightning/zap-hit","status/stunned"],"rule":"不變更傷害與眩暈秒數。"},{"section":"D","item":"支援卡技能","trigger":"卡片登場→施法→退場","ids":["arcane/magic-circle-cast","spawn/summon-rise","arcane/blink-out"],"rule":"依現有約 1.1 秒出手安排，整體不卡手。"},{"section":"D","item":"角色合成／升星","trigger":"升星光圈、融合、短閃","ids":["ui/level-up","pickups/collect-burst"],"rule":"保留已移除的大金星噴射，不能再次加入。"},{"section":"D","item":"常駐 Buff／Debuff","trigger":"治療、盾、凍結、中毒","ids":["holy/heal-aoe","scifi/force-field","status/frozen","status/poisoned"],"rule":"每個狀態最大單個實例；支援多方混戰。"},{"section":"D","item":"第 3 關道路落雷","trigger":"偶發擊中道路並造成雙方傷害","ids":["lightning/lightning-strike","lightning/zap-hit","lightning/chain-lightning"],"rule":"**純局部**；不得使用素材原本內建的背景變暗／全畫面白閃。"},{"section":"D","item":"其他關卡雷屬性技能","trigger":"雷系幻靈／魔王大絕","ids":["lightning/charge-up","lightning/zap-hit"],"rule":"不把第 3 關「隨機道路雷」規則複製到其他關。"},{"section":"D","item":"PK 雙方出戰與特效","trigger":"真人訓練家、雙方大絕及攻擊","ids":["scifi/force-field","impacts/hit-spark","ui/damage-number"],"rule":"雙方顯示對稱；不受傷時改變場景天氣。"},{"section":"D","item":"怪物死亡與路線持續","trigger":"倒下、散去、路徑地面","ids":["spawn/dissolve-burn","spawn/poof","nature/quake"],"rule":"不得讓 pixelfx 影響道路描邊／幾何閃爍。"},{"section":"D","item":"角色與基地命中提示","trigger":"局部閃光、碰撞、傷害數字","ids":["impacts/crit-hit","ui/damage-number","ui/health-bar-hit"],"rule":"禁止 touch renderer.setClearColor、scene.background、fog、全域 lighting。"},{"section":"D-1","item":"初光草原  (meadow)","trigger":"晴天白雲","ids":["weather/clouds","weather/god-rays"],"rule":"背景固定；草地少量飄葉"},{"section":"D-1","item":"青蛙池塘  (pond)","trigger":"陰天微雨","ids":["weather/rain","weather/fog","water/rain-splash"],"rule":"低密度細雨、水面雨紋"},{"section":"D-1","item":"水仙瀑布  (waterfall)","trigger":"陰雨水霧","ids":["weather/rain","weather/fog","water/waterfall","lightning/zap-hit"],"rule":"偶發道路局部雷；絕對不變動天空亮度"},{"section":"D-1","item":"猴王果園  (orchard)","trigger":"晴朗暖陽","ids":["weather/clouds","weather/god-rays","weather/falling-leaves"],"rule":"枝葉飄散；無全屏閃爍"},{"section":"D-1","item":"雷鳴工坊  (forge)","trigger":"夕陽薄雲","ids":["weather/clouds","fire/torch","scifi/energy-core"],"rule":"雷屬大招可局部電弧；不可視為常態落雷"},{"section":"D-1","item":"牛仔荒野  (desert)","trigger":"荒野晴空","ids":["weather/god-rays","nature/quake"],"rule":"乾燥塵土、晴天保持固定"},{"section":"D-1","item":"星輝觀星台  (observatory)","trigger":"晴朗星夜","ids":["weather/shooting-stars","weather/aurora","arcane/star-fall"],"rule":"流星為裝飾，非新增傷害"},{"section":"D-1","item":"月影森林  (night)","trigger":"月影晴夜","ids":["weather/fireflies","weather/fog","critters/wisp"],"rule":"原本月色保持固定"},{"section":"D-1","item":"星穹塔下  (tower)","trigger":"靜謐飄雪","ids":["weather/snow","ice/snowflake-burst"],"rule":"雪維持輕量、不覆寫屋頂"},{"section":"D-1","item":"水蛟深淵  (abyss)","trigger":"深淵暴雨","ids":["weather/storm","weather/rain","water/wave-crash"],"rule":"暴雨強但固定；局部效果不影響環境亮度"},{"section":"E","item":"目前：商會門口聚集","trigger":"路人排隊、抵達商會","ids":["ui/exclamation","pickups/coin-spin","critters/butterfly"],"rule":"僅做外部環境輕量點綴；不更改排隊／進出路線。"},{"section":"E","item":"目前：五級建築外觀","trigger":"升級版屋簷、金光裝飾","ids":["ui/level-up","ui/achievement","pickups/gem-spin"],"rule":"五級外觀維持原本紅瓦暖色系、門口置中。"},{"section":"E","item":"目前：門牌與招牌","trigger":"商會標誌或店面光點","ids":["holy/halo","pickups/key-glint"],"rule":"不要擋住「初光商會」文字及建築模型。"},{"section":"E","item":"目前：店門開關","trigger":"門葉滑動、開門歡迎特效","ids":["pickups/collect-burst","transitions/iris"],"rule":"只在已實作開門動作時觸發；不新增假店內。"},{"section":"E","item":"目前：籌備中公告","trigger":"開啟公告、關閉視窗","ids":["ui/exclamation","transitions/diamond-wipe"],"rule":"維持目前「商會籌備中」文字，不冒充已開業。"},{"section":"E","item":"未來：雇用員工","trigger":"聘任成功、黃卡→高級員工","ids":["spawn/summon-rise","ui/achievement","ui/level-up"],"rule":"屬規劃預留；不得在本次擅自建立員工規則。"},{"section":"E","item":"未來：金幣購物／成交","trigger":"收銀、金幣轉動、交易完成","ids":["ui/coin-collect","pickups/coin-spin","pickups/collect-burst"],"rule":"只提供 UI mapping，金幣實際交易仍以未來商店邏輯為準。"},{"section":"E","item":"未來：貨架補貨","trigger":"商品放置、補貨提示","ids":["pickups/loot-beam","ui/quest-complete","pickups/crystal-shard"],"rule":"不改動玩家背包與商品庫存。"},{"section":"E","item":"未來：顧客情緒／事件","trigger":"服務滿意、排隊、損失通知","ids":["status/charmed","ui/heart-lost","ui/exclamation"],"rule":"不自動創造事件發生率或額外金幣。"},{"section":"E","item":"未來：員工升階與擴店","trigger":"店舖升級／獎勵","ids":["ui/level-up","ui/confetti","transitions/star-iris"],"rule":"先納入映射表，程式實作確認後才啟用。"},{"section":"F","item":"星穹挑戰塔普通攻擊","trigger":"主角武器、怪物受擊","ids":["melee/sword-slash","projectiles/bullet-tracer","impacts/hit-spark"],"rule":"檢查 tower/index.html 大型單頁及 survivors/js/tower-fx.js。"},{"section":"F","item":"星穹挑戰塔大招","trigger":"四類武器／Boss 波次","ids":["melee/heavy-cleave","scifi/laser-grid","arcane/mana-burst"],"rule":"只替換視覺，不改敵人生成、碰撞、技能書。"},{"section":"F","item":"星穹挑戰塔戰利品","trigger":"卡片、寶箱、技能書、回塔","ids":["pickups/chest-open","pickups/loot-beam","ui/achievement"],"rule":"保留素材兌換價值及抽卡機率。"},{"section":"F","item":"初光挑戰：小山","trigger":"落地震動、驚嚇、可投球窗口","ids":["impacts/ground-slam","nature/quake","ui/countdown"],"rule":"保留 1-2-3 木頭人行為；不能因特效更改攻防窗口。"},{"section":"F","item":"初光挑戰：小飯糰","trigger":"紫色光波推開主角","ids":["arcane/mana-burst","arcane/rune-circle","impacts/ground-slam"],"rule":"保留四個可回收波圈和各圈單次命中。"},{"section":"F","item":"初光挑戰：歐頭慢","trigger":"虹彩光束、麻痺","ids":["arcane/arcane-beam","scifi/laser-grid","status/stunned"],"rule":"光束應保留七色視覺及有效範圍。"},{"section":"F","item":"初光挑戰：光凰鷹","trigger":"羽毛彈幕、光環、飛行攻擊","ids":["holy/feather-burst","projectiles/magic-missile","impacts/hit-spark"],"rule":"保留空中飛行與攻擊邊界。"},{"section":"F","item":"圖鑑模型室","trigger":"角色預覽招式與命中木頭人","ids":["impacts/hit-spark","water/splash","fire/fireball"],"rule":"同一戰技配置共用，但不得擅自播放進化動畫。"},{"section":"F","item":"全局 UI／勝利／失敗","trigger":"副本入口、任務完成、獎勵","ids":["ui/quest-complete","ui/achievement","transitions/pixel-dissolve"],"rule":"手機橫直向都不能被粒子覆蓋按鈕。"}]